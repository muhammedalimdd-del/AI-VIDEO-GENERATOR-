# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# OWNER_NOTIFICATION_EMAIL: Website owner email where new requests are forwarded.
OWNER_NOTIFICATION_EMAIL="owner@example.com"

# EMAIL_FROM_ADDRESS: The email address appearing in the From header for notifications and delivery.
EMAIL_FROM_ADDRESS="studio@example.com"

# EMAIL_PROVIDER_API_KEY: (Optional) Transactional email provider API key (e.g. Resend, Sendgrid).
EMAIL_PROVIDER_API_KEY=""

# SMTP settings (Optional - if using SMTP instead of API provider):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ADMIN_PASSWORD: Password for the private owner admin dashboard (default: admin123).
ADMIN_PASSWORD="admin123"

