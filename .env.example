# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# OWNER_NOTIFICATION_EMAIL: Website owner email where new requests are forwarded.
OWNER_NOTIFICATION_EMAIL="muhammedalimdd@gmail.com"

# EMAIL_FROM_ADDRESS: The email address appearing in the From header for notifications and delivery.
EMAIL_FROM_ADDRESS="muhammedalimdd@gmail.com"

# Transactional Email API Keys (Server-side only: Resend or SendGrid)
EMAIL_PROVIDER_API_KEY=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# SMTP settings (Server-side only - e.g. Gmail App Password or custom SMTP):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="muhammedalimdd@gmail.com"
SMTP_PASS=""

# ADMIN_PASSWORD: Password for the private owner admin dashboard (default: videomaker2026).
ADMIN_PASSWORD="videomaker2026"


