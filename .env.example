# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# OWNER_NOTIFICATION_EMAIL: Admin email where all new customer video requests are automatically delivered.
OWNER_NOTIFICATION_EMAIL="muhammedalimdd@gmail.com"
ADMIN_NOTIFICATION_EMAIL="muhammedalimdd@gmail.com"

# RESEND_API_KEY: Server-side Resend API Key for automatic email delivery (https://resend.com/api-keys)
# Never expose this key in frontend code (do not prefix with VITE_).
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender address for Resend (defaults to AI Video Maker <onboarding@resend.dev> if not using a custom domain)
RESEND_FROM_EMAIL="AI Video Maker <onboarding@resend.dev>"

# EMAIL_FROM_ADDRESS: Fallback From header for custom domain or SMTP
EMAIL_FROM_ADDRESS="muhammedalimdd@gmail.com"

# Optional Secondary Email Providers (Server-side only)
EMAIL_PROVIDER_API_KEY=""
SENDGRID_API_KEY=""

# Optional SMTP settings (Server-side only):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="muhammedalimdd@gmail.com"
SMTP_PASS=""

# ADMIN_PASSWORD: Password for the private owner admin dashboard (default: videomaker2026).
ADMIN_PASSWORD="videomaker2026"
