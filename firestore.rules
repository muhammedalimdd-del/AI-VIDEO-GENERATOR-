rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'muhammedalimdd@gmail.com'
      );
    }

    // User profile validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'trialStatus']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt', 'trialStatus', 'role']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.trialStatus in ['eligible', 'used', 'claimed'];
    }

    // Video request validation
    function isValidVideoRequest(data) {
      return data.keys().hasAll(['id', 'createdAt', 'status', 'userId', 'userEmail', 'title', 'requestType']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.requestType in ['free_trial', 'paid_order'];
    }

    // Budget request validation
    function isValidBudgetRequest(data) {
      return data.keys().hasAll(['id', 'createdAt', 'status', 'customerName', 'customerEmail', 'videoIdea']) &&
        data.id is string && data.id.size() <= 64 &&
        data.customerName is string && data.customerName.size() <= 128 &&
        data.customerEmail is string && data.customerEmail.size() <= 256 &&
        data.videoIdea is string && data.videoIdea.size() <= 4096;
    }

    // Users collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        (request.auth.uid == userId || isAdmin()) &&
        isValidUser(incoming()) &&
        (!('role' in incoming()) || incoming().role == 'user' || isAdmin());
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        (request.auth.uid == userId || isAdmin()) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (!('role' in incoming()) || incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();
    }

    // Video Requests collection rules
    match /video_requests/{requestId} {
      allow get: if isSignedIn() &&
        isValidId(requestId) &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        isValidVideoRequest(incoming());
      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            isValidVideoRequest(incoming()) &&
            // Regular user cannot change status to delivered/approved or alter pricing
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'storyDescription', 'style', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    // Budget Requests collection rules
    match /budget_requests/{budgetRequestId} {
      allow get: if isSignedIn() &&
        isValidId(budgetRequestId) &&
        (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(budgetRequestId) && isValidBudgetRequest(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admins registry rules
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
